      <div class="gallery-grid">
        <figure class="gallery-item">
          <a href="../../images/Sketches/grins/Bugs%20Grin%20B&amp;W.jpg" target="_blank" rel="noopener noreferrer">
            <img src="../../images/Sketches/grins/Bugs%20Grin%20B&amp;W.jpg" alt="Bugs Grin B&amp;W by Ron English" loading="lazy" />
          </a>
        </figure>

        <figure class="gallery-item">
          <a href="../../images/Sketches/grins/Bugs%20Grin%20COLOR.jpg" target="_blank" rel="noopener noreferrer">
            <img src="../../images/Sketches/grins/Bugs%20Grin%20COLOR.jpg" alt="Bugs Grin COLOR by Ron English" loading="lazy" />
          </a>
        </figure>

      </div>
    </section>

    <div class="back-link">
      <a href="index.html">&larr; Back to Grins</a>
    </div>
  </main>
</body>
</html>

