    <section class="section-card" aria-labelledby="original-drawing">
      <h2 id="original-drawing">Original Drawing</h2>

      <div class="originals-grid">
        <figure class="gallery-item">
          <a href="../../images/Sketches/grins/Bugs%20Grin%20ORIGINAL.jpg" target="_blank" rel="noopener noreferrer">
            <img src="../../images/Sketches/grins/Bugs%20Grin%20ORIGINAL.jpg" alt="Bugs Grin ORIGINAL by Ron English" loading="lazy" />
